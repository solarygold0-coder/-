<ui:FluentWindow x:Class="PatientRecordsSaudi.Desktop.ReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="التنبيهات القريبة" Width="920" Height="620" MinWidth="760" MinHeight="500"
    WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" Background="{StaticResource CanvasBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,18">
      <StackPanel>
        <TextBlock Text="التنبيهات القريبة" Foreground="White" FontSize="24" FontWeight="Bold" />
        <TextBlock Text="اضغط اسم المراجع أو عنوان الموعد أو المهمة لفتح ملفه مباشرة." Foreground="#C7DED5" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
    <TabControl Grid.Row="1" Margin="20">
      <TabItem Header="المواعيد">
        <Grid>
          <DataGrid x:Name="AppointmentsGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="100" />
              <DataGridTemplateColumn Header="اسم المراجع" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding PatientName}" Click="OpenPatient_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="الموعد" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding Title}" Click="OpenPatient_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="200" />
              <DataGridTextColumn Header="الوقت" Binding="{Binding TimeText}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="AppointmentsEmpty" Style="{StaticResource EmptyStateStyle}" Text="لا توجد مواعيد قريبة." />
        </Grid>
      </TabItem>
      <TabItem Header="المهام">
        <Grid>
          <DataGrid x:Name="TasksGrid">
            <DataGrid.Columns>
              <DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="100" />
              <DataGridTemplateColumn Header="اسم المراجع" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding PatientName}" Click="OpenPatient_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTemplateColumn Header="المهمة" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding Title}" Click="OpenPatient_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="الموعد" Binding="{Binding DueText}" Width="190" />
              <DataGridTextColumn Header="الأولوية" Binding="{Binding Priority}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="TasksEmpty" Style="{StaticResource EmptyStateStyle}" Text="لا توجد مهام قريبة." />
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="Close_Click" Content="إغلاق" />
    </Border>
  </Grid>
</ui:FluentWindow>
