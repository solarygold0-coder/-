<Window x:Class="SaudiPatientDesk.AppointmentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة موعد" Width="700" Height="620" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Border Background="White" CornerRadius="18" Margin="16" Padding="30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="إضافة موعد جديد" FontSize="27" FontWeight="Bold"/><TextBlock Text="أدخل رقم الملف لتعبئة اسم المريض تلقائياً" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Row="2">
        <TextBlock Text="رقم الملف" Margin="0,0,0,6"/><TextBox x:Name="FileNumberBox" MaxLength="8" TextChanged="FileNumberBox_TextChanged"/>
        <Border Background="#F4F7FB" CornerRadius="9" Padding="13" Margin="0,8,0,18"><TextBlock x:Name="PatientNameText" Text="لم يتم اختيار مريض" FontWeight="SemiBold"/></Border>
        <TextBlock Text="التاريخ الميلادي" Margin="0,0,0,6"/>
        <UniformGrid Columns="3" FlowDirection="LeftToRight">
          <ComboBox x:Name="DayBox" Margin="4"/>
          <ComboBox x:Name="MonthBox" Margin="4"/>
          <ComboBox x:Name="YearBox" Margin="4"/>
        </UniformGrid>
        <TextBlock Text="الوقت" Margin="0,18,0,6"/>
        <UniformGrid Columns="2" FlowDirection="LeftToRight">
          <ComboBox x:Name="MinuteBox" Margin="4"/>
          <ComboBox x:Name="HourBox" Margin="4"/>
        </UniformGrid>
        <TextBlock Text="ملاحظات" Margin="0,18,0,6"/><TextBox x:Name="NotesBox" Height="75" AcceptsReturn="True" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
        <Button Style="{StaticResource SecondaryButton}" Margin="6" Click="Cancel_Click" Content="إلغاء"/>
        <Button Style="{StaticResource PrimaryButton}" Margin="6" Click="Save_Click" Content="حفظ الموعد"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
