<ui:FluentWindow x:Class="PatientRecordsSaudi.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="نظام إدارة سجلات المراجعين" Width="1440" Height="900"
    MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen"
    WindowState="Maximized" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
    Background="{StaticResource CanvasBrush}" SizeChanged="MainWindow_SizeChanged">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="270" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="1" Background="{StaticResource PrimaryDarkBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="138" />
          <RowDefinition Height="*" />
          <RowDefinition Height="92" />
        </Grid.RowDefinitions>
        <StackPanel Margin="22,26,22,14">
          <Border Width="52" Height="52" CornerRadius="14" Background="#1F9D75" HorizontalAlignment="Right">
            <TextBlock Text="✚" Foreground="White" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="سجلات المراجعين" Foreground="White" FontSize="21" FontWeight="Bold" Margin="0,10,0,0" />
          <TextBlock Text="إدارة مكتبية آمنة ومنظمة" Foreground="#B9D5CA" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,8">
          <Button x:Name="DashboardNav" Style="{StaticResource NavButtonStyle}" Click="DashboardNav_Click" Background="#1F715A" Content="⌂    الرئيسية" />
          <Button x:Name="PatientsNav" Style="{StaticResource NavButtonStyle}" Click="PatientsNav_Click" Content="👤   المراجعون" />
          <Button x:Name="AppointmentsNav" Style="{StaticResource NavButtonStyle}" Click="AppointmentsNav_Click" Content="◷    المواعيد" />
          <Button x:Name="TasksNav" Style="{StaticResource NavButtonStyle}" Click="TasksNav_Click" Content="✓    المهام والتنبيهات" />
          <Button x:Name="InventoryNav" Style="{StaticResource NavButtonStyle}" Click="InventoryNav_Click" Content="☷    الجرد السنوي" />
          <Button x:Name="SettingsNav" Style="{StaticResource NavButtonStyle}" Click="SettingsNav_Click" Content="⚙    الإعدادات" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#2A6B5B" BorderThickness="0,1,0,0" Padding="20,14">
          <StackPanel>
            <TextBlock x:Name="SessionNameText" Foreground="White" FontWeight="SemiBold" Text="المستخدم المحلي" />
            <TextBlock Text="الإصدار 6.0 — WPF Fluent" Foreground="#A6C8BC" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TopTitleText" Text="الرئيسية" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock x:Name="ClinicNameText" Text="نظام إدارة سجلات المراجعين" Foreground="{StaticResource MutedBrush}" FontSize="12" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
            <Button Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" MinWidth="48" Content="⟳" ToolTip="تحديث البيانات" />
            <TextBlock x:Name="TodayText" VerticalAlignment="Center" Foreground="#334155" FontWeight="SemiBold" Margin="14,0" FlowDirection="RightToLeft" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" x:Name="PageHost">
        <Border x:Name="DashboardPage" Padding="22">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <StackPanel Margin="4,0,4,16">
                <StackPanel>
                  <TextBlock Text="صباح الخير" Style="{StaticResource PageTitleStyle}" />
                  <TextBlock Text="كل ما تحتاجه لإدارة العمل اليومي في مكان واحد." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <WrapPanel Margin="0,10,0,0">
                  <Button Style="{StaticResource PrimaryButtonStyle}" Click="NewPatient_Click" Content="＋  مراجع جديد" />
                  <Button Style="{StaticResource PrimaryButtonStyle}" Click="NewAppointment_Click" Content="＋  موعد جديد" />
                  <Button Style="{StaticResource PrimaryButtonStyle}" Click="NewTask_Click" Content="＋  مهمة جديدة" />
                </WrapPanel>
              </StackPanel>

              <WrapPanel Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Width="206"><StackPanel><TextBlock Text="المراجعون النشطون" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="ActivePatientsCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0" /></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Width="206"><StackPanel><TextBlock Text="مواعيد اليوم" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="TodayAppointmentsCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0" /></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Width="206"><StackPanel><TextBlock Text="القادمة خلال 30 يومًا" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="UpcomingAppointmentsCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#7C3AED" Margin="0,8,0,0" /></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Width="206"><StackPanel><TextBlock Text="المهام المفتوحة" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="OpenTasksCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0" /></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Width="206"><StackPanel><TextBlock Text="مرشحو الجرد" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="InventoryCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="#C2413B" Margin="0,8,0,0" /></StackPanel></Border>
              </WrapPanel>

              <Grid x:Name="DashboardTablesGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="DashboardAppointmentsCard" Style="{StaticResource CardStyle}" Margin="6,6,8,6">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="360" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><TextBlock Text="مواعيد اليوم" FontSize="18" FontWeight="Bold" /><Button HorizontalAlignment="Left" Style="{StaticResource LinkButtonStyle}" Click="AppointmentsNav_Click" Content="عرض الكل ←" /></Grid>
                    <DataGrid Grid.Row="1" x:Name="DashboardTodayGrid">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="الوقت" Binding="{Binding TimeText}" Width="90" />
                        <DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="90" />
                        <DataGridTemplateColumn Header="اسم المراجع" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding PatientName}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="الموعد" Width="1.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding Title}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" x:Name="DashboardTodayEmpty" Style="{StaticResource EmptyStateStyle}" Text="لا توجد مواعيد مسجلة اليوم.&#10;استخدم زر «موعد جديد» لإضافة أول موعد." />
                  </Grid>
                </Border>
                <Border x:Name="DashboardTasksCard" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,6,6,6">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="360" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><TextBlock Text="المهام المفتوحة" FontSize="18" FontWeight="Bold" /><Button HorizontalAlignment="Left" Style="{StaticResource LinkButtonStyle}" Click="TasksNav_Click" Content="عرض الكل ←" /></Grid>
                    <DataGrid Grid.Row="1" x:Name="DashboardTasksGrid">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="الأولوية" Binding="{Binding Priority}" Width="90" />
                        <DataGridTemplateColumn Header="المراجع" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding PatientName}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="المهمة" Width="1.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding Title}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="الموعد" Binding="{Binding DueText}" Width="145" />
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" x:Name="DashboardTasksEmpty" Style="{StaticResource EmptyStateStyle}" Text="لا توجد مهام مفتوحة.&#10;استخدم زر «مهمة جديدة» لإضافة تنبيه مرتبط بمراجع." />
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Border x:Name="PatientsPage" Padding="22" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="4,0,4,14" LastChildFill="True"><WrapPanel DockPanel.Dock="Left"><Button Style="{StaticResource PrimaryButtonStyle}" Click="NewPatient_Click" Content="＋  مراجع جديد" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="EditPatient_Click" Content="فتح ملف المراجع" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="NewAppointmentForPatient_Click" Content="موعد للمحدد" /><Button Style="{StaticResource DangerButtonStyle}" Click="ArchivePatient_Click" Content="أرشفة / استعادة" /></WrapPanel><TextBlock Text="المراجعون" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" /></DockPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="4,0,4,14" Padding="14"><WrapPanel>
              <TextBox x:Name="PatientSearchText" Width="290" Margin="5" ToolTip="اكتب بيانات البحث" TextChanged="PatientSearch_Changed" />
              <ComboBox x:Name="PatientSearchMode" Width="170" Margin="5" SelectionChanged="PatientSearch_Changed"><ComboBoxItem Content="الكل" IsSelected="True" /><ComboBoxItem Content="رقم الملف" /><ComboBoxItem Content="الهوية/الإقامة" /><ComboBoxItem Content="الاسم" /><ComboBoxItem Content="رقم الجوال" /><ComboBoxItem Content="المدينة" /></ComboBox>
              <ComboBox x:Name="PatientSortMode" Width="150" Margin="5" SelectionChanged="PatientSearch_Changed"><ComboBoxItem Content="رقم الملف" IsSelected="True" /><ComboBoxItem Content="الاسم" /><ComboBoxItem Content="الأحدث" /><ComboBoxItem Content="آخر مراجعة" /></ComboBox>
              <CheckBox x:Name="ShowArchivedCheck" Content="إظهار المؤرشفين" VerticalAlignment="Center" Margin="14,0" Checked="PatientSearch_Changed" Unchecked="PatientSearch_Changed" />
              <Button Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" Content="تحديث" />
            </WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="4" Padding="0"><Grid><DataGrid x:Name="PatientsGrid" MouseDoubleClick="PatientsGrid_MouseDoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="100" />
                <DataGridTemplateColumn Header="اسم المراجع" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding FullName}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="الهوية / الإقامة" Binding="{Binding NationalId}" Width="160" />
                <DataGridTextColumn Header="الجوال" Binding="{Binding Mobile}" Width="145" />
                <DataGridTextColumn Header="المدينة" Binding="{Binding City}" Width="*" />
                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="100" />
              </DataGrid.Columns>
            </DataGrid><TextBlock x:Name="PatientsEmpty" Style="{StaticResource EmptyStateStyle}" Text="لا توجد نتائج مطابقة.&#10;غيّر خيارات البحث أو أضف مراجعًا جديدًا." /></Grid></Border>
          </Grid>
        </Border>

        <Border x:Name="AppointmentsPage" Padding="22" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="4,0,4,14" LastChildFill="True"><WrapPanel DockPanel.Dock="Left"><Button Style="{StaticResource PrimaryButtonStyle}" Click="NewAppointment_Click" Content="＋  موعد جديد" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="EditAppointment_Click" Content="تعديل الموعد" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="PrintAppointment_Click" Content="طباعة الموعد" /><Button Style="{StaticResource DangerButtonStyle}" Click="DeleteAppointment_Click" Content="نقل للمحذوفات" /></WrapPanel><TextBlock Text="المواعيد" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" /></DockPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="4,0,4,14" Padding="14"><WrapPanel><TextBlock Text="عرض:" VerticalAlignment="Center" Margin="5" /><ComboBox x:Name="AppointmentFilter" Width="180" Margin="5" SelectionChanged="AppointmentFilter_Changed"><ComboBoxItem Content="القادمة" IsSelected="True" /><ComboBoxItem Content="اليوم" /><ComboBoxItem Content="هذا الأسبوع" /><ComboBoxItem Content="الكل" /></ComboBox><TextBlock Text="انقر على اسم المراجع أو الموعد لفتح ملفه." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="20,0" /></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="4" Padding="0"><Grid><DataGrid x:Name="AppointmentsGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="95" />
                <DataGridTemplateColumn Header="اسم المراجع" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding PatientName}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="الموعد" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding Title}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="التاريخ الميلادي" Binding="{Binding DateText}" Width="210" />
                <DataGridTextColumn Header="الوقت" Binding="{Binding TimeText}" Width="100" />
                <DataGridTextColumn Header="النوع" Binding="{Binding VisitType}" Width="130" />
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="130" />
              </DataGrid.Columns>
            </DataGrid><TextBlock x:Name="AppointmentsEmpty" Style="{StaticResource EmptyStateStyle}" Text="لا توجد مواعيد ضمن نطاق العرض الحالي." /></Grid></Border>
          </Grid>
        </Border>

        <Border x:Name="TasksPage" Padding="22" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="4,0,4,14" LastChildFill="True"><WrapPanel DockPanel.Dock="Left"><Button Style="{StaticResource PrimaryButtonStyle}" Click="NewTask_Click" Content="＋  مهمة جديدة" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="EditTask_Click" Content="تعديل" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="ToggleTask_Click" Content="تغيير الحالة" /><Button Style="{StaticResource DangerButtonStyle}" Click="DeleteTask_Click" Content="نقل للمحذوفات" /></WrapPanel><TextBlock Text="المهام والتنبيهات" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" /></DockPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="4,0,4,14" Padding="14"><WrapPanel><CheckBox x:Name="ShowCompletedCheck" Content="إظهار المهام المكتملة" Margin="8" Checked="ShowCompleted_Changed" Unchecked="ShowCompleted_Changed" /><TextBlock Text="انقر على اسم المراجع أو المهمة لفتح ملفه." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="20,0" /></WrapPanel></Border>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="4" Padding="0"><Grid><DataGrid x:Name="TasksGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="95" />
                <DataGridTemplateColumn Header="اسم المراجع" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding PatientName}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="المهمة / التنبيه" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding Title}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="الموعد الميلادي" Binding="{Binding DueText}" Width="190" />
                <DataGridTextColumn Header="الأولوية" Binding="{Binding Priority}" Width="110" />
                <DataGridTextColumn Header="الحالة" Binding="{Binding CompletionText}" Width="110" />
              </DataGrid.Columns>
            </DataGrid><TextBlock x:Name="TasksEmpty" Style="{StaticResource EmptyStateStyle}" Text="لا توجد مهام ضمن العرض الحالي." /></Grid></Border>
          </Grid>
        </Border>

        <Border x:Name="InventoryPage" Padding="22" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="4,0,4,14" LastChildFill="True"><WrapPanel DockPanel.Dock="Left"><Button Style="{StaticResource SecondaryButtonStyle}" Click="EditInventoryPatient_Click" Content="فتح الملف" /><Button Style="{StaticResource DangerButtonStyle}" Click="ArchiveInventory_Click" Content="أرشفة بعد المراجعة" /></WrapPanel><StackPanel><TextBlock Text="الجرد السنوي" Style="{StaticResource PageTitleStyle}" /><TextBlock Text="ملفات لم يسجل لها نشاط منذ عشر سنوات أو أكثر. الأرشفة لا تعيد استخدام رقم الملف." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" /></StackPanel></DockPanel>
            <Border Grid.Row="1" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" CornerRadius="12" Padding="14" Margin="4,0,4,14"><TextBlock Text="تنبيه: راجع المتطلبات النظامية وسياسة المنشأة قبل أرشفة أي سجل." Foreground="#9A3412" FontWeight="SemiBold" /></Border>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="4" Padding="0"><Grid><DataGrid x:Name="InventoryGrid" MouseDoubleClick="InventoryGrid_MouseDoubleClick">
              <DataGrid.Columns><DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="100" /><DataGridTemplateColumn Header="اسم المراجع" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Style="{StaticResource LinkButtonStyle}" Content="{Binding FullName}" Click="OpenPatientFromRow_Click" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="الهوية / الإقامة" Binding="{Binding NationalId}" Width="180" /><DataGridTextColumn Header="الجوال" Binding="{Binding Mobile}" Width="150" /><DataGridTextColumn Header="آخر مراجعة" Binding="{Binding LastVisitAt, StringFormat=yyyy/MM/dd}" Width="150" /></DataGrid.Columns>
            </DataGrid><TextBlock x:Name="InventoryEmpty" Style="{StaticResource EmptyStateStyle}" Text="لا توجد ملفات مرشحة للجرد حاليًا." /></Grid></Border>
          </Grid>
        </Border>

        <Border x:Name="SettingsPage" Padding="22" Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">
              <TextBlock Text="الإعدادات" Style="{StaticResource PageTitleStyle}" Margin="4,0,4,14" />
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="بيانات المنشأة" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="اسم المنشأة" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="ClinicNameBox" Margin="5" />
                    <TextBlock Grid.Column="2" Text="رقم التواصل" VerticalAlignment="Center" /><TextBox Grid.Column="3" x:Name="ClinicPhoneBox" Margin="5" />
                    <TextBlock Grid.Row="1" Text="العنوان" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="ClinicAddressBox" Margin="5" />
                  </Grid>
                  <Separator Margin="4,14" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="شعار الطباعة" VerticalAlignment="Center" />
                    <WrapPanel Grid.Column="1">
                      <Button x:Name="ChooseLogoButton" Style="{StaticResource SecondaryButtonStyle}" Click="ChooseClinicLogo_Click" Content="اختيار شعار" />
                      <Button x:Name="RemoveLogoButton" Style="{StaticResource DangerButtonStyle}" Click="RemoveClinicLogo_Click" Content="إزالة الشعار" />
                      <TextBlock x:Name="ClinicLogoStatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="12,0" />
                    </WrapPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="الدوام والمواعيد" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                  <TextBlock Text="يمنع النظام تلقائيًا حجز الجمعة والسبت وأيام الإغلاق، كما يمنع أي موعد خارج ساعات الدوام." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                  <WrapPanel>
                    <StackPanel Width="250" Margin="4"><TextBlock Text="بداية الدوام" FontWeight="SemiBold" Margin="4" /><ComboBox x:Name="WorkStartBox" IsEditable="False" /></StackPanel>
                    <StackPanel Width="250" Margin="4"><TextBlock Text="نهاية الدوام" FontWeight="SemiBold" Margin="4" /><ComboBox x:Name="WorkEndBox" IsEditable="False" /></StackPanel>
                    <StackPanel Width="250" Margin="4"><TextBlock Text="مدة الموعد الافتراضية" FontWeight="SemiBold" Margin="4" /><ComboBox x:Name="DefaultDurationBox" IsEditable="False" /></StackPanel>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="القوائم القابلة للتخصيص" FontSize="18" FontWeight="Bold" />
                  <TextBlock Text="اكتب قيمة واحدة في كل سطر. يجب أن تتضمن حالات الموعد «حضر» و«ملغي»." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" />
                  <WrapPanel>
                    <StackPanel Width="330" Margin="4"><TextBlock Text="أنواع الزيارة" FontWeight="SemiBold" Margin="4" /><TextBox x:Name="VisitTypesText" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel>
                    <StackPanel Width="330" Margin="4"><TextBlock Text="حالات الموعد" FontWeight="SemiBold" Margin="4" /><TextBox x:Name="AppointmentStatusesText" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel>
                    <StackPanel Width="330" Margin="4"><TextBlock Text="أولويات المهام" FontWeight="SemiBold" Margin="4" /><TextBox x:Name="TaskPrioritiesText" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel>
                    <StackPanel Width="330" Margin="4"><TextBlock Text="خيارات الجنس" FontWeight="SemiBold" Margin="4" /><TextBox x:Name="GenderOptionsText" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel>
                    <StackPanel Width="330" Margin="4"><TextBlock Text="فصائل الدم" FontWeight="SemiBold" Margin="4" /><TextBox x:Name="BloodTypesText" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></StackPanel>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Text="النسخ الاحتياطي التلقائي" FontSize="18" FontWeight="Bold" />
                  <TextBlock Text="تُحفظ النسخ داخل مجلد بيانات التطبيق افتراضيًا. اختيار قرص خارجي يوفر حماية أفضل عند تعطل قرص الجهاز." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12" />
                  <WrapPanel>
                    <StackPanel Width="250" Margin="4"><TextBlock Text="التكرار" FontWeight="SemiBold" Margin="4" /><ComboBox x:Name="BackupIntervalBox" /></StackPanel>
                    <StackPanel Width="680" Margin="4"><TextBlock Text="مجلد النسخ" FontWeight="SemiBold" Margin="4" /><DockPanel><Button x:Name="InternalBackupFolderButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButtonStyle}" Click="ResetAutoBackupDirectory_Click" Content="المجلد الداخلي" /><Button x:Name="ChooseBackupFolderButton" DockPanel.Dock="Left" Style="{StaticResource SecondaryButtonStyle}" Click="ChooseAutoBackupDirectory_Click" Content="اختيار مجلد" /><TextBox x:Name="AutoBackupDirectoryBox" IsReadOnly="True" Margin="5" /></DockPanel></StackPanel>
                  </WrapPanel>
                  <TextBlock x:Name="BackupStatusText" Foreground="{StaticResource MutedBrush}" Margin="5,10,5,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Grid x:Name="SettingsActionsGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="SecuritySettingsCard" Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="الدخول والصلاحيات" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="يفتح التطبيق مباشرة افتراضيًا بلا اسم مستخدم أو كلمة مرور. أنشئ حسابًا باسم شخصي ثم فعّل الدخول فقط عند الحاجة." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8" />
                    <CheckBox x:Name="RequireLoginCheck" Content="طلب تسجيل الدخول عند بدء التطبيق" Margin="4,8" />
                    <Button x:Name="ManageUsersButton" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="ManageUsers_Click" Content="إدارة المستخدمين والصلاحيات" />
                  </StackPanel>
                </Border>
                <Border x:Name="BackupSettingsCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="النسخ والاستعادة" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="نسخة محمية تضم قاعدة SQLite المشفرة وإعدادات فتحها." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8" />
                    <WrapPanel><Button x:Name="CreateBackupButton" Style="{StaticResource PrimaryButtonStyle}" Click="CreateBackup_Click" Content="إنشاء نسخة الآن" /><Button x:Name="RestoreBackupButton" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreBackup_Click" Content="استعادة نسخة" /></WrapPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="أيام الإغلاق والإجازات" FontSize="18" FontWeight="Bold" /><TextBlock Text="تمنع المواعيد في الأيام المحددة، إضافة إلى الجمعة والسبت." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8" /><Button x:Name="ClosuresButton" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="Closures_Click" Content="إدارة أيام الإغلاق" /></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="المحذوفات القابلة للاستعادة" FontSize="18" FontWeight="Bold" /><TextBlock Text="استعادة المواعيد والمهام التي نُقلت إلى المحذوفات." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8" /><Button x:Name="RecycleBinButton" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Click="RecycleBin_Click" Content="فتح المحذوفات" /></StackPanel></Border>
              </Grid>

              <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" MinWidth="190" Click="SaveSettings_Click" Content="حفظ جميع الإعدادات" />

              <Border Style="{StaticResource CardStyle}" Background="#ECFDF5" BorderBrush="#A7F3D0">
                <StackPanel><TextBlock Text="واجهة حديثة" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" /><TextBlock Text="WPF على .NET 10 + مكتبة WPF-UI 4.3 (Fluent) — قاعدة بيانات SQLite مشفرة — تطبيق Win32 مستقل غير محزوم." TextWrapping="Wrap" Foreground="#166534" Margin="0,8,0,0" /></StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</ui:FluentWindow>
