<Window x:Class="SaudiPatientDesk.PatientEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ملف المريض" Width="720" Height="690" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
  <Border Background="White" CornerRadius="18" Margin="16" Padding="30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="Heading" Text="إضافة مريض جديد" FontSize="27" FontWeight="Bold"/>
        <TextBlock x:Name="FileNumberText" Text="سيُنشأ رقم الملف تلقائياً" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
      </StackPanel>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.ColumnSpan="3"><TextBlock Text="الاسم الكامل *" Margin="0,0,0,6"/><TextBox x:Name="FullNameBox"/></StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="رقم الهوية *" Margin="0,0,0,6"/><TextBox x:Name="NationalIdBox" MaxLength="10" PreviewTextInput="DigitsOnly_PreviewTextInput"/></StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="رقم الجوال *" Margin="0,0,0,6"/><TextBox x:Name="MobileBox" MaxLength="10" PreviewTextInput="DigitsOnly_PreviewTextInput"/></StackPanel>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="3"><TextBlock Text="وسيلة اتصال إضافية" Margin="0,0,0,6"/><TextBox x:Name="SecondaryBox"/></StackPanel>
        <StackPanel Grid.Row="6" Grid.ColumnSpan="3"><TextBlock Text="معلومات طبية مختصرة" Margin="0,0,0,6"/><TextBox x:Name="MedicalBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
        <Border Grid.Row="8" Grid.ColumnSpan="3" Background="#EAF7F5" CornerRadius="9" Padding="12">
          <TextBlock Text="الحقول المعلّمة بنجمة مطلوبة. سيكتشف النظام السجل المكرر قبل الحفظ." Foreground="#0B6661"/>
        </Border>
      </Grid>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight">
        <Button Style="{StaticResource SecondaryButton}" Margin="6" Click="Cancel_Click" Content="إلغاء"/>
        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Margin="6" Click="Save_Click" Content="إضافة المريض"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
