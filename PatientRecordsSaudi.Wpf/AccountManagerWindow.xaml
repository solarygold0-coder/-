<ui:FluentWindow x:Class="PatientRecordsSaudi.Desktop.AccountManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="المستخدمون والصلاحيات" Width="900" Height="620" MinWidth="760" MinHeight="520"
    WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Background="{StaticResource CanvasBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="66" /></Grid.RowDefinitions>
    <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,12"><StackPanel VerticalAlignment="Center"><TextBlock Text="المستخدمون والصلاحيات" Foreground="White" FontSize="23" FontWeight="Bold" /><TextBlock Text="لا يُنشأ أي حساب افتراضي؛ أضف حسابات مسماة عند الحاجة فقط." Foreground="#B9D5CA" Margin="0,4,0,0" /></StackPanel></Border>
    <WrapPanel Grid.Row="1" Margin="18,14"><Button Style="{StaticResource PrimaryButtonStyle}" Click="AddUser_Click" Content="＋  إضافة مستخدم" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="ResetPassword_Click" Content="إعادة تعيين كلمة المرور" /><Button Style="{StaticResource DangerButtonStyle}" Click="ToggleUser_Click" Content="تفعيل / تعطيل" /></WrapPanel>
    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="18,0"><DataGrid x:Name="UsersGrid"><DataGrid.Columns><DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="*" /><DataGridTextColumn Header="اسم الموظف" Binding="{Binding DisplayName}" Width="1.5*" /><DataGridTextColumn Header="الصلاحية" Binding="{Binding Role}" Width="*" /><DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="*" /></DataGrid.Columns></DataGrid></Border>
    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14"><Button Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="Close_Click" Content="إغلاق" /></Border>
  </Grid>
</ui:FluentWindow>
