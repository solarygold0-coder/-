<Window x:Class="PatientRecordsSaudi.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام إدارة سجلات المراجعين" MinWidth="1100" MinHeight="720" WindowState="Maximized" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Background="{StaticResource PrimaryBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="24,0"><TextBlock Text="{Binding TodayCaption}" Foreground="White" FontWeight="Bold"/><TextBlock Text="ميلادي فقط" Foreground="#BFE1E8" FontSize="12"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="سجلات المراجعين والمواعيد" Foreground="White" FontWeight="Bold" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="{Binding ClinicName}" Foreground="#D5EEF3" HorizontalAlignment="Center"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="24,0"><TextBlock Text="{Binding UserCaption}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left"/><TextBlock Text="WPF • الإصدار 2.0" Foreground="#BFE1E8" FontSize="12" HorizontalAlignment="Left"/></StackPanel>
    </Grid>

    <TabControl Grid.Row="1" x:Name="MainTabs" Margin="8" FontSize="15">
      <TabItem Header="الملخص">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <UniformGrid Grid.Row="0" Columns="5">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="المراجعون النشطون"/><TextBlock Text="{Binding ActivePatientCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="مواعيد اليوم"/><TextBlock Text="{Binding TodayAppointmentCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="المواعيد القادمة"/><TextBlock Text="{Binding UpcomingAppointmentCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="المهام المفتوحة"/><TextBlock Text="{Binding OpenTaskCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="جرد عشر سنوات"/><TextBlock Text="{Binding InventoryCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/></StackPanel></Border>
          </UniformGrid>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <GroupBox Header="مواعيد اليوم — اضغط الاسم أو الموعد لفتح الملف" Margin="8">
              <DataGrid ItemsSource="{Binding TodayAppointments}" MouseDoubleClick="AppointmentGrid_DoubleClick">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="الملف" Binding="{Binding FileNumber}" Width="80"/>
                  <DataGridTemplateColumn Header="المراجع" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding PatientName}" Tag="{Binding PatientId}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="الموعد" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding PatientId}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="الوقت" Binding="{Binding TimeText}" Width="110"/>
                  <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="المهام القادمة — اضغط الاسم أو المهمة لفتح الملف" Margin="8">
              <DataGrid ItemsSource="{Binding DueTasks}" MouseDoubleClick="TaskGrid_DoubleClick">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="الملف" Binding="{Binding FileNumber}" Width="70"/>
                  <DataGridTemplateColumn Header="المراجع" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding PatientName}" Tag="{Binding PatientId}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="المهمة" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding PatientId}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueText}" Width="170"/>
                </DataGrid.Columns>
              </DataGrid>
            </GroupBox>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="المراجعون">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="8">
            <Button Content="مراجع جديد" Click="AddPatient_Click"/><Button Content="فتح/تعديل الملف" Click="EditPatient_Click"/><Button Content="أرشفة" Click="ArchivePatient_Click" Style="{StaticResource DangerButton}"/>
            <Button Content="موعد جديد" Click="AddAppointmentForPatient_Click"/><Button Content="مهمة جديدة" Click="AddTaskForPatient_Click"/>
            <CheckBox Content="إظهار المؤرشفين" IsChecked="{Binding IncludeArchived}"/>
            <TextBlock Text="فرز:" VerticalAlignment="Center" Margin="8,0"/><ComboBox Width="130" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}"/>
            <TextBlock Text="بحث بـ:" VerticalAlignment="Center" Margin="8,0"/><ComboBox Width="150" ItemsSource="{Binding SearchModes}" SelectedItem="{Binding SearchMode}"/>
            <TextBox x:Name="SearchBox" Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown"/>
            <Button Content="بحث" Click="Search_Click"/><Button Content="تحديث" Click="Refresh_Click"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Top" Text="السعة الإدارية: 10,000 مراجع — البحث برقم الملف أو الهوية/الإقامة أو الاسم أو الجوال أو المدينة" Foreground="#52666B" Margin="14,0,14,4"/>
          <DataGrid x:Name="PatientsGrid" ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" MouseDoubleClick="PatientGrid_DoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="95"/>
              <DataGridTemplateColumn Header="اسم المراجع" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding FullName}" Tag="{Binding Id}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="الهوية/الإقامة" Binding="{Binding NationalId}" Width="145"/><DataGridTextColumn Header="الجوال" Binding="{Binding Mobile}" Width="135"/><DataGridTextColumn Header="المدينة" Binding="{Binding City}" Width="*"/><DataGridTextColumn Header="تاريخ الميلاد" Binding="{Binding BirthDateText}" Width="120"/><DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="المواعيد">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="8"><Button Content="موعد جديد" Click="AddAppointment_Click"/><Button Content="تعديل الموعد" Click="EditAppointment_Click"/><Button Content="طباعة الموعد" Click="PrintAppointment_Click"/><Button Content="نقل للمحذوفات" Click="DeleteAppointment_Click" Style="{StaticResource DangerButton}"/><Button Content="تحديث" Click="Refresh_Click"/></WrapPanel>
          <DataGrid x:Name="AppointmentsGrid" ItemsSource="{Binding Appointments}" SelectedItem="{Binding SelectedAppointment}" MouseDoubleClick="AppointmentGrid_DoubleClick">
            <DataGrid.Columns><DataGridTextColumn Header="الملف" Binding="{Binding FileNumber}" Width="80"/><DataGridTemplateColumn Header="المراجع" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding PatientName}" Tag="{Binding PatientId}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="اسم الموعد" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding PatientId}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="التاريخ الميلادي" Binding="{Binding DateText}" Width="210"/><DataGridTextColumn Header="الوقت" Binding="{Binding TimeText}" Width="100"/><DataGridTextColumn Header="المدة" Binding="{Binding DurationMinutes}" Width="75"/><DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="130"/></DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="المهام والتنبيهات">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="8"><Button Content="مهمة جديدة" Click="AddTask_Click"/><Button Content="تعديل" Click="EditTask_Click"/><Button Content="تبديل مكتملة" Click="ToggleTask_Click"/><Button Content="نقل للمحذوفات" Click="DeleteTask_Click" Style="{StaticResource DangerButton}"/><CheckBox Content="إظهار المكتملة" IsChecked="{Binding IncludeCompleted}"/><Button Content="تحديث" Click="Refresh_Click"/></WrapPanel>
          <DataGrid x:Name="TasksGrid" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" MouseDoubleClick="TaskGrid_DoubleClick">
            <DataGrid.Columns><DataGridTextColumn Header="الملف" Binding="{Binding FileNumber}" Width="80"/><DataGridTemplateColumn Header="المراجع" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding PatientName}" Tag="{Binding PatientId}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="المهمة/التنبيه" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Title}" Tag="{Binding PatientId}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueText}" Width="190"/><DataGridTextColumn Header="الأولوية" Binding="{Binding Priority}" Width="110"/><DataGridTextColumn Header="الحالة" Binding="{Binding CompletionText}" Width="110"/></DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="الجرد السنوي">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="8"><Button Content="فحص الآن" Click="Refresh_Click"/><Button Content="فتح ملف المراجع" Click="OpenInventoryPatient_Click"/><Button Content="أرشفة بعد المراجعة" Click="ArchiveInventory_Click" Style="{StaticResource DangerButton}"/><TextBlock Text="الملفات التي مضت عشر سنوات دون مراجعة؛ لا يوجد حذف تلقائي." Foreground="{StaticResource DangerBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="18,0"/></WrapPanel>
          <DataGrid x:Name="InventoryGrid" ItemsSource="{Binding InventoryPatients}" SelectedItem="{Binding SelectedInventoryPatient}" MouseDoubleClick="InventoryGrid_DoubleClick">
            <DataGrid.Columns><DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="100"/><DataGridTemplateColumn Header="اسم المراجع" Width="2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding FullName}" Tag="{Binding Id}" Click="OpenPatient_Click" Style="{StaticResource LinkButton}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="الهوية/الإقامة" Binding="{Binding NationalId}" Width="150"/><DataGridTextColumn Header="الجوال" Binding="{Binding Mobile}" Width="140"/><DataGridTextColumn Header="آخر مراجعة" Binding="{Binding LastVisitAt, StringFormat=yyyy/MM/dd}" Width="130"/></DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#E2EBED" Padding="12,4"><TextBlock Text="{Binding StatusText}" Foreground="#42575C"/></Border>
  </Grid>
</Window>
