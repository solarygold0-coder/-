<ui:FluentWindow x:Class="PatientRecordsSaudi.Wpf.PasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="كلمة المرور" Width="460" Height="380" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Background="{StaticResource CanvasBrush}">
  <Border Margin="24" Style="{StaticResource CardStyle}" Padding="28"><StackPanel>
    <TextBlock x:Name="TitleText" Text="كلمة المرور الجديدة" FontSize="21" FontWeight="Bold" Margin="0,0,0,18" />
    <TextBlock Text="كلمة المرور" FontWeight="SemiBold" Margin="3,4" /><PasswordBox x:Name="PasswordBox" Height="40" Padding="10,7" Margin="0,0,0,10" />
    <TextBlock Text="التأكيد" FontWeight="SemiBold" Margin="3,4" /><PasswordBox x:Name="ConfirmBox" Height="40" Padding="10,7" Margin="0,0,0,8" />
    <TextBlock Text="حروف إنجليزية صغيرة وأرقام فقط، بحد أقصى 4 من كل نوع." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,14" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" Content="حفظ" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Content="إلغاء" /></StackPanel>
  </StackPanel></Border>
</ui:FluentWindow>
