<ui:FluentWindow x:Class="PatientRecordsSaudi.Desktop.AppointmentEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:PatientRecordsSaudi.Desktop.Controls"
    Title="موعد" Width="820" Height="720" MinWidth="720" MinHeight="650"
    WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
    Background="{StaticResource CanvasBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
    <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,12"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="HeaderText" Text="موعد جديد" Foreground="White" FontSize="23" FontWeight="Bold" /><TextBlock Text="التاريخ والوقت بالقوائم الدوّارة — ميلادي فقط" Foreground="#B9D5CA" Margin="0,4,0,0" /></StackPanel></Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
      <Border Style="{StaticResource CardStyle}"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="رقم ملف المراجع" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="FileNumberBox" Width="210" Margin="5" MaxLength="6" PreviewTextInput="DigitsOnly_PreviewTextInput" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="ResolvePatient_Click" Content="جلب بيانات المراجع" /></StackPanel>
        <TextBlock Grid.Row="1" Text="اسم المراجع" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" x:Name="PatientNameBox" IsReadOnly="True" Background="#EEF2F4" Margin="5" />
        <TextBlock Grid.Row="2" Text="الهوية / الإقامة" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" x:Name="NationalIdBox" IsReadOnly="True" Background="#EEF2F4" Margin="5" />
        <TextBlock Grid.Row="3" Text="الجوال" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" x:Name="MobileBox" IsReadOnly="True" Background="#EEF2F4" Margin="5" />
      </Grid></Border>
      <Border Style="{StaticResource CardStyle}"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="عنوان الموعد" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="TitleBox" MaxLength="150" Margin="5" />
        <TextBlock Grid.Row="1" Text="نوع الزيارة" VerticalAlignment="Center" /><ComboBox Grid.Row="1" Grid.Column="1" x:Name="VisitTypeBox" Margin="5" />
        <TextBlock Grid.Row="2" Text="التاريخ والوقت الميلادي" VerticalAlignment="Center" /><controls:DateTimeScrollPicker Grid.Row="2" Grid.Column="1" x:Name="StartsAtPicker" ShowTime="True" Margin="5" />
        <TextBlock Grid.Row="3" Text="المدة بالدقائق" VerticalAlignment="Center" /><ComboBox Grid.Row="3" Grid.Column="1" x:Name="DurationBox" Margin="5"><ComboBoxItem Content="15" /><ComboBoxItem Content="30" IsSelected="True" /><ComboBoxItem Content="45" /><ComboBoxItem Content="60" /><ComboBoxItem Content="90" /><ComboBoxItem Content="120" /></ComboBox>
        <TextBlock Grid.Row="4" Text="الحالة" VerticalAlignment="Center" /><ComboBox Grid.Row="4" Grid.Column="1" x:Name="StatusBox" Margin="5" />
        <TextBlock Grid.Row="5" Text="ملاحظات" VerticalAlignment="Top" Margin="0,12,0,0" /><TextBox Grid.Row="5" Grid.Column="1" x:Name="NotesBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="1000" Margin="5" />
      </Grid></Border>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="18,10"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" Content="حفظ الموعد" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Content="إلغاء" /></StackPanel></Border>
  </Grid>
</ui:FluentWindow>
