<Window x:Class="PatientRecordsSaudi.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:model="using:PatientRecordsSaudi.Models"
        Title="نظام إدارة سجلات المراجعين">
  <Grid FlowDirection="RightToLeft" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <NavigationView x:Name="Shell" PaneTitle="سجلات المراجعين" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="Shell_SelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="الملخص" Tag="dashboard"><NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="المراجعون" Tag="patients"><NavigationViewItem.Icon><SymbolIcon Symbol="People"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="المواعيد" Tag="appointments"><NavigationViewItem.Icon><SymbolIcon Symbol="Calendar"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="المهام والتنبيهات" Tag="tasks"><NavigationViewItem.Icon><SymbolIcon Symbol="Flag"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="الجرد السنوي" Tag="inventory"><NavigationViewItem.Icon><SymbolIcon Symbol="Document"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem Content="الإعدادات والنسخ" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.Header>
        <Grid MinHeight="64"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="نظام إدارة سجلات المراجعين" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="ClinicCaption" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock x:Name="UserCaption" FontWeight="SemiBold"/><TextBlock x:Name="DateCaption" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
      </NavigationView.Header>
      <Grid Padding="18">
        <Grid x:Name="DashboardPage">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="المراجعون النشطون"/><TextBlock x:Name="PatientCount" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/></StackPanel></Border>
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="مواعيد اليوم"/><TextBlock x:Name="TodayCount" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/></StackPanel></Border>
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="المواعيد القادمة"/><TextBlock x:Name="UpcomingCount" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/></StackPanel></Border>
            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="المهام المفتوحة"/><TextBlock x:Name="TaskCount" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrandBrush}"/></StackPanel></Border>
            <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16"><StackPanel><TextBlock Text="جرد عشر سنوات"/><TextBlock x:Name="InventoryCount" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/></StackPanel></Border>
          </Grid>
          <Grid Grid.Row="1" Margin="0,18,0,0" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="مواعيد اليوم — اضغط لفتح ملف المراجع" FontWeight="SemiBold" FontSize="17"/><ListView x:Name="TodayAppointmentsList" IsItemClickEnabled="True" ItemClick="Appointment_ItemClick"><ListView.ItemTemplate><DataTemplate x:DataType="model:Appointment"><Grid Padding="8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind FileNumber}"/><TextBlock Grid.Column="1" Text="{x:Bind PatientName}"/><TextBlock Grid.Column="2" Text="{x:Bind TimeText}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Text="المهام القريبة — اضغط لفتح ملف المراجع" FontWeight="SemiBold" FontSize="17"/><ListView x:Name="DueTasksList" IsItemClickEnabled="True" ItemClick="Task_ItemClick"><ListView.ItemTemplate><DataTemplate x:DataType="model:PatientTask"><Grid Padding="8" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind FileNumber}"/><TextBlock Grid.Column="1" Text="{x:Bind Title}"/><TextBlock Grid.Column="2" Text="{x:Bind DueText}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
          </Grid>
        </Grid>

        <Grid x:Name="PatientsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="مراجع جديد" Style="{StaticResource PrimaryAction}" Click="AddPatient_Click"/><Button Content="فتح/تعديل الملف" Click="EditPatient_Click"/><Button Content="أرشفة" Click="ArchivePatient_Click"/><Button Content="موعد جديد" Click="AppointmentForPatient_Click"/><Button Content="مهمة جديدة" Click="TaskForPatient_Click"/><ComboBox x:Name="SearchMode" Width="155" SelectedIndex="0"><x:String>الكل</x:String><x:String>رقم الملف</x:String><x:String>الهوية/الإقامة</x:String><x:String>الاسم</x:String><x:String>رقم الجوال</x:String><x:String>المدينة</x:String></ComboBox><TextBox x:Name="SearchText" Width="260" PlaceholderText="اكتب للبحث"/><Button Content="بحث" Click="Search_Click"/></StackPanel>
          <ListView Grid.Row="1" x:Name="PatientsList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Patient_ItemClick"><ListView.ItemTemplate><DataTemplate x:DataType="model:Patient"><Grid Padding="10" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind FileNumber}"/><TextBlock Grid.Column="1" Text="{x:Bind FullName}" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}"/><TextBlock Grid.Column="2" Text="{x:Bind NationalId}"/><TextBlock Grid.Column="3" Text="{x:Bind Mobile}"/><TextBlock Grid.Column="4" Text="{x:Bind City}"/><TextBlock Grid.Column="5" Text="{x:Bind StatusText}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
        </Grid>

        <Grid x:Name="AppointmentsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="موعد جديد" Style="{StaticResource PrimaryAction}" Click="AddAppointment_Click"/><Button Content="تعديل" Click="EditAppointment_Click"/><Button Content="حذف إداري" Click="DeleteAppointment_Click"/><Button Content="تحديث" Click="Refresh_Click"/></StackPanel><ListView Grid.Row="1" x:Name="AppointmentsList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Appointment_ItemClick"><ListView.ItemTemplate><DataTemplate x:DataType="model:Appointment"><Grid Padding="10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind FileNumber}"/><TextBlock Grid.Column="1" Text="{x:Bind PatientName}" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}"/><TextBlock Grid.Column="2" Text="{x:Bind Title}"/><TextBlock Grid.Column="3" Text="{x:Bind DateText}"/><TextBlock Grid.Column="4" Text="{x:Bind TimeText}"/><TextBlock Grid.Column="5" Text="{x:Bind Status}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>

        <Grid x:Name="TasksPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="مهمة جديدة" Style="{StaticResource PrimaryAction}" Click="AddTask_Click"/><Button Content="تعديل" Click="EditTask_Click"/><Button Content="تبديل مكتملة" Click="ToggleTask_Click"/><Button Content="حذف إداري" Click="DeleteTask_Click"/><Button Content="تحديث" Click="Refresh_Click"/></StackPanel><ListView Grid.Row="1" x:Name="TasksList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Task_ItemClick"><ListView.ItemTemplate><DataTemplate x:DataType="model:PatientTask"><Grid Padding="10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind FileNumber}"/><TextBlock Grid.Column="1" Text="{x:Bind PatientName}" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}"/><TextBlock Grid.Column="2" Text="{x:Bind Title}"/><TextBlock Grid.Column="3" Text="{x:Bind DueText}"/><TextBlock Grid.Column="4" Text="{x:Bind Priority}"/><TextBlock Grid.Column="5" Text="{x:Bind CompletionText}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>

        <Grid x:Name="InventoryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="الجرد السنوي للملفات التي مضت عشر سنوات دون مراجعة" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="لا يتم الحذف تلقائيًا. راجع الملف ثم أرشفه إداريًا مع بقاء رقم الملف محفوظًا." Foreground="{ThemeResource SystemFillColorCriticalBrush}"/></StackPanel><ListView Grid.Row="1" x:Name="InventoryList" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Patient_ItemClick"><ListView.ItemTemplate><DataTemplate x:DataType="model:Patient"><Grid Padding="10" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind FileNumber}"/><TextBlock Grid.Column="1" Text="{x:Bind FullName}" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}"/><TextBlock Grid.Column="2" Text="{x:Bind NationalId}"/><TextBlock Grid.Column="3" Text="{x:Bind Mobile}"/><TextBlock Grid.Column="4" Text="{x:Bind City}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid>

        <StackPanel x:Name="SettingsPage" Visibility="Collapsed" Spacing="12" MaxWidth="760" HorizontalAlignment="Center"><TextBlock Text="الإعدادات والنسخ الاحتياطي" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="يُحفظ كل إدخال مكتمل مباشرة داخل قاعدة LiteDB المشفرة. عند انقطاع الطاقة تبقى المعاملات المكتملة محفوظة." TextWrapping="Wrap"/><TextBox x:Name="BackupFolder" Header="مجلد النسخ الاحتياطي" PlaceholderText="اتركه فارغًا لاستخدام مجلد النسخ التلقائي داخل بيانات التطبيق"/><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="إنشاء نسخة احتياطية الآن" Style="{StaticResource PrimaryAction}" Click="Backup_Click"/><Button Content="تحديث جميع البيانات" Click="Refresh_Click"/></StackPanel><InfoBar IsOpen="True" Severity="Informational" Title="التثبيت" Message="يُوزع هذا الإصدار كحزمة MSIX عبر App Installer أو Microsoft Store. لا يوجد تثبيت صامت."/></StackPanel>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
