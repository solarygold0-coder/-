    <RootNamespace>PatientRecordsSaudi</RootNamespace>
    <AssemblyName>PatientRecordsSaudi.Modern.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Version>6.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>Mohammed Mousa Asiri</Company>
    <Product>Saudi Patient Records</Product>
    <Copyright>Copyright © Mohammed Mousa Asiri 2026</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>
</Project>
