<ui:FluentWindow x:Class="PatientRecordsSaudi.Desktop.PatientEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:PatientRecordsSaudi.Desktop.Controls"
    Title="ملف المراجع" Width="980" Height="760" MinWidth="840" MinHeight="650"
    WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
    Background="{StaticResource CanvasBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
    <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,12">
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="HeaderText" Text="ملف المراجع" Foreground="White" FontSize="23" FontWeight="Bold" /><TextBlock x:Name="HeaderSubText" Foreground="#B9D5CA" Margin="0,4,0,0" /></StackPanel>
    </Border>
    <TabControl Grid.Row="1" x:Name="EditorTabs" Margin="18">
      <TabItem x:Name="PersonalTab" Header="البيانات الأساسية">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="رقم الملف" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="FileNumberBox" IsReadOnly="True" Background="#EEF2F4" Margin="5" />
          <TextBlock Grid.Column="2" Text="نوع الهوية" VerticalAlignment="Center" /><ComboBox Grid.Column="3" x:Name="IdentityTypeBox" Margin="5"><ComboBoxItem Content="هوية وطنية" IsSelected="True" /><ComboBoxItem Content="إقامة" /></ComboBox>
          <TextBlock Grid.Row="1" Text="رقم الهوية / الإقامة" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" x:Name="NationalIdBox" MaxLength="10" Margin="5" PreviewTextInput="DigitsOnly_PreviewTextInput" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="الاسم الكامل" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="3" x:Name="FullNameBox" MaxLength="150" Margin="5" />
          <TextBlock Grid.Row="2" Text="الجنس" VerticalAlignment="Center" /><ComboBox Grid.Row="2" Grid.Column="1" x:Name="GenderBox" Margin="5" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="الجنسية" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="3" x:Name="NationalityBox" MaxLength="50" Margin="5" />
          <TextBlock Grid.Row="3" Text="فصيلة الدم" VerticalAlignment="Center" /><ComboBox Grid.Row="3" Grid.Column="1" x:Name="BloodTypeBox" Margin="5" />
          <TextBlock Grid.Row="3" Grid.Column="2" Text="تاريخ الميلاد الميلادي" VerticalAlignment="Center" /><controls:DateTimeScrollPicker Grid.Row="3" Grid.Column="3" x:Name="BirthDatePicker" ShowTime="False" Margin="5" />
        </Grid></ScrollViewer>
      </TabItem>
      <TabItem x:Name="ContactTab" Header="التواصل والعنوان">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="22">
          <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <TextBlock Text="رقم الجوال" VerticalAlignment="Center" /><TextBox Grid.Column="1" x:Name="MobileBox" MaxLength="16" Margin="5" PreviewTextInput="Phone_PreviewTextInput" />
          <TextBlock Grid.Column="2" Text="هاتف بديل" VerticalAlignment="Center" /><TextBox Grid.Column="3" x:Name="AlternatePhoneBox" MaxLength="16" Margin="5" PreviewTextInput="Phone_PreviewTextInput" />
          <TextBlock Grid.Row="1" Text="المدينة" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" x:Name="CityBox" MaxLength="50" Margin="5" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="العنوان" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="3" x:Name="AddressBox" MaxLength="250" Margin="5" />
          <TextBlock Grid.Row="2" Text="اسم جهة الطوارئ" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" x:Name="EmergencyNameBox" MaxLength="100" Margin="5" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="جوال الطوارئ" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="3" x:Name="EmergencyPhoneBox" MaxLength="16" Margin="5" PreviewTextInput="Phone_PreviewTextInput" />
        </Grid></ScrollViewer>
      </TabItem>
      <TabItem x:Name="MedicalTab" Header="المعلومات الطبية والإدارية">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
          <TextBlock Text="الحساسيات الدوائية / الغذائية" FontWeight="SemiBold" Margin="4" /><TextBox x:Name="AllergiesBox" Height="95" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="1000" Margin="4,0,4,14" />
          <TextBlock Text="الأمراض المزمنة" FontWeight="SemiBold" Margin="4" /><TextBox x:Name="ChronicBox" Height="95" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="1000" Margin="4,0,4,14" />
          <TextBlock Text="ملاحظات طبية وإدارية" FontWeight="SemiBold" Margin="4" /><TextBox x:Name="NotesBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="3000" Margin="4" />
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="AttachmentsTab" Header="المرفقات المشفرة">
        <Grid Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,12">
            <ComboBox x:Name="AttachmentCategoryBox" Width="140" Margin="4"><ComboBoxItem Content="هوية" IsSelected="True" /><ComboBoxItem Content="إحالة" /><ComboBoxItem Content="نتيجة" /><ComboBoxItem Content="خطاب" /><ComboBoxItem Content="أخرى" /></ComboBox>
            <Button x:Name="AddAttachmentButton" Style="{StaticResource PrimaryButtonStyle}" Click="AddAttachment_Click" Content="إضافة مرفق" />
            <Button Style="{StaticResource SecondaryButtonStyle}" Click="OpenAttachment_Click" Content="فتح المحدد" />
            <Button x:Name="DeleteAttachmentButton" Style="{StaticResource DangerButtonStyle}" Click="DeleteAttachment_Click" Content="نقل للمحذوفات" />
            <Button x:Name="RestoreAttachmentButton" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreAttachment_Click" Content="استعادة" />
            <CheckBox x:Name="ShowDeletedAttachmentsCheck" Content="إظهار المحذوفة" VerticalAlignment="Center" Margin="12,0" Checked="ShowDeletedAttachments_Changed" Unchecked="ShowDeletedAttachments_Changed" />
          </WrapPanel>
          <DataGrid Grid.Row="1" x:Name="AttachmentsGrid" MouseDoubleClick="AttachmentsGrid_MouseDoubleClick">
            <DataGrid.Columns><DataGridTextColumn Header="اسم الملف" Binding="{Binding OriginalName}" Width="2*" /><DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="*" /><DataGridTextColumn Header="الحجم" Binding="{Binding SizeText}" Width="100" /><DataGridTextColumn Header="تاريخ الرفع" Binding="{Binding UploadedText}" Width="160" /><DataGridTextColumn Header="المستخدم" Binding="{Binding UploadedBy}" Width="130" /><DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="90" /></DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" Content="حفظ ملف المراجع" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Content="إغلاق" /></StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
