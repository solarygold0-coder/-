<ui:FluentWindow x:Class="PatientRecordsSaudi.Desktop.RecycleBinWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="المحذوفات القابلة للاستعادة" Width="960" Height="650" MinWidth="800" MinHeight="560"
    WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Background="{StaticResource CanvasBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="70" /></Grid.RowDefinitions>
    <Border Background="{StaticResource PrimaryDarkBrush}" Padding="24,12"><StackPanel VerticalAlignment="Center"><TextBlock Text="المحذوفات القابلة للاستعادة" Foreground="White" FontSize="23" FontWeight="Bold" /><TextBlock Text="أرقام الملفات لا يعاد استخدامها عند الحذف أو الأرشفة." Foreground="#B9D5CA" Margin="0,4,0,0" /></StackPanel></Border>
    <TabControl Grid.Row="1" x:Name="RecycleTabs" Margin="18">
      <TabItem Header="المواعيد المحذوفة"><DataGrid x:Name="AppointmentsGrid"><DataGrid.Columns><DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="100" /><DataGridTextColumn Header="المراجع" Binding="{Binding PatientName}" Width="2*" /><DataGridTextColumn Header="الموعد" Binding="{Binding Title}" Width="2*" /><DataGridTextColumn Header="تاريخ الحذف" Binding="{Binding DeletedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="180" /></DataGrid.Columns></DataGrid></TabItem>
      <TabItem Header="المهام المحذوفة"><DataGrid x:Name="TasksGrid"><DataGrid.Columns><DataGridTextColumn Header="رقم الملف" Binding="{Binding FileNumber}" Width="100" /><DataGridTextColumn Header="المراجع" Binding="{Binding PatientName}" Width="2*" /><DataGridTextColumn Header="المهمة" Binding="{Binding Title}" Width="2*" /><DataGridTextColumn Header="تاريخ الحذف" Binding="{Binding DeletedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="180" /></DataGrid.Columns></DataGrid></TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Style="{StaticResource PrimaryButtonStyle}" Click="Restore_Click" Content="استعادة المحدد" /><Button Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click" Content="إغلاق" /></StackPanel></Border>
  </Grid>
</ui:FluentWindow>
