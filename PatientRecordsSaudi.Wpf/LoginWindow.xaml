<ui:FluentWindow x:Class="PatientRecordsSaudi.Desktop.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="تسجيل الدخول" Width="470" Height="520" ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" Background="{StaticResource CanvasBrush}">
  <Grid>
    <Border Margin="34" Style="{StaticResource CardStyle}" Padding="32">
      <StackPanel>
        <Border Width="66" Height="66" CornerRadius="18" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"><TextBlock Text="✚" Foreground="White" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <TextBlock Text="سجلات المراجعين" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,3" />
        <TextBlock Text="تسجيل الدخول مفعّل من الإعدادات" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />
        <TextBlock Text="اسم المستخدم" FontWeight="SemiBold" Margin="3,0,3,5" /><TextBox x:Name="UsernameBox" Margin="0,0,0,14" />
        <TextBlock Text="كلمة المرور" FontWeight="SemiBold" Margin="3,0,3,5" /><PasswordBox x:Name="PasswordBox" Height="40" Padding="10,7" Margin="0,0,0,20" />
        <Button Style="{StaticResource PrimaryButtonStyle}" Click="Login_Click" Content="دخول" IsDefault="True" />
        <Button Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" Content="إلغاء" IsCancel="True" />
        <TextBlock Text="لا يوجد حساب admin أو كلمة مرور افتراضية." Foreground="{StaticResource MutedBrush}" FontSize="12" TextAlignment="Center" Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</ui:FluentWindow>
